{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Product Vault REST API backed by the built-in node:sqlite database.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "tsx --disable-warning=ExperimentalWarning src/index.ts",
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jose": "^6.2.13",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "fast-check": "^3.23.2",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
